window = {
	name = "scene_picker_window"
	size = { 400 600 }
	parentanchor = center
	movable = yes
	layer = top
	filter_mouse = all

	using = Window_Background
	using = Window_Decoration_Flat

	vbox = {
		using = Window_Margins
		spacing = 10

		header_standard = {
			layoutpolicy_horizontal = expanding
			blockoverride "header_text"
			{
				text = "SELECT_SCENE_HEADER"
			}
			blockoverride "button_close"
			{
				onclick = "[ExecuteConsoleCommand('gui.ClearWidgets scene_picker_window')]"
			}
		}

		scrollbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			blockoverride "scrollbox_content"
			{
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 5

					# Generic Scenes
					button_scene_picker = {
						visible = "[GetTriggeredGui('is_valid_scene_throneroom').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						blockoverride "text" { text = "talk_scene_throneroom" }
						onclick = "[GetScriptedGui('select_scene').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scene', MakeScopeFlag('talk_scene_throneroom')).End)]"
					}
					button_scene_picker = {
						visible = "[GetTriggeredGui('is_valid_scene_garden').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						blockoverride "text" { text = "talk_scene_garden" }
						onclick = "[GetScriptedGui('select_scene').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scene', MakeScopeFlag('talk_scene_garden')).End)]"
					}
					button_scene_picker = {
						visible = "[GetTriggeredGui('is_valid_scene_tavern').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						blockoverride "text" { text = "talk_scene_tavern" }
						onclick = "[GetScriptedGui('select_scene').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scene', MakeScopeFlag('talk_scene_tavern')).End)]"
					}
					button_scene_picker = {
						visible = "[GetTriggeredGui('is_valid_scene_market').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						blockoverride "text" { text = "talk_scene_market" }
						onclick = "[GetScriptedGui('select_scene').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scene', MakeScopeFlag('talk_scene_market')).End)]"
					}
					button_scene_picker = {
						visible = "[GetTriggeredGui('is_valid_scene_bedchamber').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						blockoverride "text" { text = "talk_scene_bedchamber" }
						onclick = "[GetScriptedGui('select_scene').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scene', MakeScopeFlag('talk_scene_bedchamber')).End)]"
					}
					button_scene_picker = {
						visible = "[GetTriggeredGui('is_valid_scene_dungeon').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						blockoverride "text" { text = "talk_scene_dungeon" }
						onclick = "[GetScriptedGui('select_scene').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scene', MakeScopeFlag('talk_scene_dungeon')).End)]"
					}
					button_scene_picker = {
						visible = "[GetTriggeredGui('is_valid_scene_feast').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						blockoverride "text" { text = "talk_scene_feast" }
						onclick = "[GetScriptedGui('select_scene').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scene', MakeScopeFlag('talk_scene_feast')).End)]"
					}
					button_scene_picker = {
						visible = "[GetTriggeredGui('is_valid_scene_temple').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						blockoverride "text" { text = "talk_scene_temple" }
						onclick = "[GetScriptedGui('select_scene').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scene', MakeScopeFlag('talk_scene_temple')).End)]"
					}
					button_scene_picker = {
						visible = "[GetTriggeredGui('is_valid_scene_alley').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						blockoverride "text" { text = "talk_scene_alley" }
						onclick = "[GetScriptedGui('select_scene').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scene', MakeScopeFlag('talk_scene_alley')).End)]"
					}
					button_scene_picker = {
						visible = "[GetTriggeredGui('is_valid_scene_armycamp').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						blockoverride "text" { text = "talk_scene_armycamp" }
						onclick = "[GetScriptedGui('select_scene').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scene', MakeScopeFlag('talk_scene_armycamp')).End)]"
					}
					button_scene_picker = {
						visible = "[GetTriggeredGui('is_valid_scene_courtyard_night').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						blockoverride "text" { text = "talk_scene_courtyard_night" }
						onclick = "[GetScriptedGui('select_scene').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scene', MakeScopeFlag('talk_scene_courtyard_night')).End)]"
					}
					button_scene_picker = {
						visible = "[GetTriggeredGui('is_valid_scene_camp').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						blockoverride "text" { text = "talk_scene_camp" }
						onclick = "[GetScriptedGui('select_scene').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scene', MakeScopeFlag('talk_scene_camp')).End)]"
					}
					button_scene_picker = {
						visible = "[GetTriggeredGui('is_valid_scene_study').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						blockoverride "text" { text = "talk_scene_study" }
						onclick = "[GetScriptedGui('select_scene').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scene', MakeScopeFlag('talk_scene_study')).End)]"
					}
					button_scene_picker = {
						visible = "[GetTriggeredGui('is_valid_scene_councilchamber').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						blockoverride "text" { text = "talk_scene_councilchamber" }
						onclick = "[GetScriptedGui('select_scene').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scene', MakeScopeFlag('talk_scene_councilchamber')).End)]"
					}
					button_scene_picker = {
						visible = "[GetTriggeredGui('is_valid_scene_battlefield').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						blockoverride "text" { text = "talk_scene_battlefield" }
						onclick = "[GetScriptedGui('select_scene').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scene', MakeScopeFlag('talk_scene_battlefield')).End)]"
					}

					# Specific Scenes
					button_scene_picker = {
						visible = "[GetTriggeredGui('is_valid_scene_iron_throne').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						blockoverride "text" { text = "talk_scene_iron_throne" }
						onclick = "[GetScriptedGui('select_scene').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scene', MakeScopeFlag('talk_scene_iron_throne')).End)]"
					}
					button_scene_picker = {
						visible = "[GetTriggeredGui('is_valid_scene_harem').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						blockoverride "text" { text = "talk_scene_harem" }
						onclick = "[GetScriptedGui('select_scene').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scene', MakeScopeFlag('talk_scene_harem')).End)]"
					}
					button_scene_picker = {
						visible = "[GetTriggeredGui('is_valid_scene_lingyinsi').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						blockoverride "text" { text = "talk_scene_lingyinsi" }
						onclick = "[GetScriptedGui('select_scene').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scene', MakeScopeFlag('talk_scene_lingyinsi')).End)]"
					}
				}
			}
		}
	}
}

types ScenePickerTypes
{
	type button_scene_picker = button_standard {
		size = { 350 40 }
		block "text" { text = "SCENE_NAME" }
	}
}
