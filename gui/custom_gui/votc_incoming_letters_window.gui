			flowcontainer = {
				size = { 660 24 }
				direction = horizontal
				spacing = 8
				button_radio = {
					size = { 24 24 }
					parentanchor = vcenter
					frame = "[BoolTo1And2( EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('votc_incoming_letters_frequency').GetValue, '(CFixedPoint)4' ) )]"
