window = {
	name = "votc_incoming_letters_window"
	size = { 700 940 }
	parentanchor = center
	movable = no
	layer = top
	filter_mouse = all
	alwaystransparent = no

	using = Background_Letter_No_Frame
	background = {
		using = Background_Area_Dark
		alpha = 0.92
	}

	# A container is the vanilla absolute-positioning parent.  Unlike widget,
	# it does not add the positions of successive children as a vertical flow.
	container = {
		name = "votc_incoming_letters_content"
		size = { 660 900 }
		parentanchor = top|left
		widgetanchor = top|left
		position = { 20 20 }

		widget = {
			size = { 660 56 }
			parentanchor = top|left
			widgetanchor = top|left
			position = { 0 0 }

			background = {
				using = Background_Header
				margin = { 2 0 }
			}
			background = {
				using = Background_Header_Pattern
				margin = { 2 0 }
			}

			text_single = {
				parentanchor = hcenter|vcenter
				widgetanchor = hcenter|vcenter
				text = votc_incoming_letters_settings_title
				using = Font_Type_Flavor
				using = Font_Size_Big
				align = center
			}

			button_close = {
				parentanchor = right|vcenter
				widgetanchor = right|vcenter
				position = { -8 0 }
				onclick = "[ExecuteConsoleCommand('GUI.ClearWidgets votc_incoming_letters_window')]"
				tooltip = CLOSE_TOOLTIP
			}
		}

		text_single = {
			parentanchor = top|left
			widgetanchor = top|left
			position = { 0 68 }
			size = { 660 46 }
			text = votc_incoming_letters_settings_desc
			default_format = "#weak"
			multiline = yes
		}

		# VOTC-194 §19: the master letter toggle lives here now (moved from the
		# retired .140 event).  Keys are STATE-named (opt_letters_on = letters
		# currently ON), the label is the AVAILABLE ACTION, so the visible
		# conditions are inverted vs the key names.  Do NOT swap the gating.
		# Both toggle buttons overlap at the same spot inside this wrapper widget
		# (only one is ever visible).  Do NOT put them back in an hbox: an
		# invisible flow sibling still reserves its slot, so the visible button
		# would jump between x=110 (letters ON) and x=340 (letters OFF) and
		# misalign with the Send Test Letter button below (pinned at x=110).
		widget = {
			size = { 660 34 }
			parentanchor = top|left
			widgetanchor = top|left
			position = { 130 102 }

			button_standard = {
				parentanchor = top|left
				widgetanchor = top|left
				position = { 110 0 }
				visible = "[Not(GetGlobalVariable('votc_ce_initiative_no_letters').IsSet)]"
				size = { 210 34 }
				text = votc_ce_initiative_opt_letters_on
				tooltip = votc_ce_initiative_opt_letters_on
				onclick = "[GetScriptedGui('votc_incoming_letters_master_disable_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			button_standard = {
				parentanchor = top|left
				widgetanchor = top|left
				position = { 110 0 }
				visible = "[GetGlobalVariable('votc_ce_initiative_no_letters').IsSet]"
				size = { 210 34 }
				text = votc_ce_initiative_opt_letters_off
				tooltip = votc_ce_initiative_opt_letters_off
				onclick = "[GetScriptedGui('votc_incoming_letters_master_enable_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
		}
		widget = {
			parentanchor = top|left
			widgetanchor = top|left
			position = { 0 195 }
			size = { 660 24 }
			text_single = {
				size = { 660 30 }
				text = votc_incoming_letters_overall_frequency_heading
				using = Font_Size_Medium
				align = center
			}
		}

		# VOTC-194 §18/§19: unified letter-frequency presets.  One row drives
		# BOTH letter channels (NPC-letter cadence + incoming-letter chance).
		widget = {
			parentanchor = top|left
			widgetanchor = top|left
			position = { 0 225 }
			size = { 660 24 }
			flowcontainer = {
				size = { 660 24 }
				direction = horizontal
				spacing = 8
				button_radio = {
					size = { 24 24 }
					parentanchor = vcenter
					frame = "[BoolTo1And2( EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('votc_incoming_letters_frequency').GetValue, '(CFixedPoint)1' ) )]"
					onclick = "[GetScriptedGui('votc_incoming_letters_unified_low_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
				text_single = {
					size = { 628 24 }
					parentanchor = vcenter
					text = votc_ce_initiative_opt_letters_freq_low
					tooltip = votc_ce_initiative_opt_letters_freq_low_effect_desc
					align = nobaseline
					multiline = yes
				}
			}
		}
		widget = {
			parentanchor = top|left
			widgetanchor = top|left
			position = { 0 249 }
			size = { 660 24 }
			flowcontainer = {
				size = { 660 24 }
				direction = horizontal
				spacing = 8
				button_radio = {
					size = { 24 24 }
					parentanchor = vcenter
					frame = "[BoolTo1And2( EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('votc_incoming_letters_frequency').GetValue, '(CFixedPoint)2' ) )]"
					onclick = "[GetScriptedGui('votc_incoming_letters_unified_medium_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
				text_single = {
					size = { 628 24 }
					parentanchor = vcenter
					text = votc_ce_initiative_opt_letters_freq_medium
					tooltip = votc_ce_initiative_opt_letters_freq_medium_effect_desc
					align = nobaseline
					multiline = yes
				}
			}
		}
		widget = {
			parentanchor = top|left
			widgetanchor = top|left
			position = { 0 273 }
			size = { 660 24 }
			flowcontainer = {
				size = { 660 24 }
				direction = horizontal
				spacing = 8
				button_radio = {
					size = { 24 24 }
					parentanchor = vcenter
					frame = "[BoolTo1And2( EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('votc_incoming_letters_frequency').GetValue, '(CFixedPoint)3' ) )]"
