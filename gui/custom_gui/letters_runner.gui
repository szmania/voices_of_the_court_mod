window = {
	name = "letters_runner"
	size = { 1% 1% }
	parentanchor = top|right
	movable = no
	#position = { -80 130 }
	layer = bottom_bottom

	state = {
		name = itsshowtime
		trigger_on_create = yes
		on_finish = "[GetVariableSystem.Set( 'blur', '1' )]"

	}

	hbox = {
		name = "letters_runner_counter"

		state = {
			name = _show
			trigger_on_create = yes
			on_finish = "[ExecuteConsoleCommand('run letters.txt')]"
		}

		state = {
			name = _show3
			trigger_on_create = yes
			on_finish = "[ExecuteConsoleCommand('run votc_letter_actions.txt')]"
		}

		state = {
			name = _show2
			trigger_when = "[Not(GetGlobalVariable('talk_scene').IsSet)]"
			duration = 2
			on_finish = "[ExecuteConsoleCommand('gui.createwidget gui/custom_gui/letters_runner.gui letters_runner_counter')]"
		}

		# VOTC-194: the NPC letter channel.  The desktop patch routes letterId
		# "npcltr" to run/npcltr.txt; this state executes it on the same beat as
		# the player's own letters.  Harmless when the file does not exist.
		state = {
			name = _show_npcltr
			trigger_on_create = yes
			on_finish = "[ExecuteConsoleCommand('run npcltr.txt')]"
		}
	}
}
