window = {
	name = "letters_runner"
	size = { 1% 1% }
	parentanchor = top|right
	movable = no
	#position = { -80 130 }
	layer = bottom_bottom

	state = {
		name = itsshowtime
		trigger_on_create = yes
		on_finish = "[GetVariableSystem.Set( 'blur', '1' )]"

	}

	hbox = {
		name = "letters_runner_counter"

		state = {
			name = _show
			trigger_on_create = yes
			on_finish = "[ExecuteConsoleCommand('run votc_ce_letters.txt')]"
		}

		state = {
			# §42 REJECTED gate: trigger_when on votc_pending_letter_action was tried and
			# reverted — nothing in either repo ever sets that global (the app's letter-action
			# writers emit only message_*_scope / votcce_action_* + trigger_event = .363), so
			# the gated state never fired and letter actions could never execute. The
			# unconditional beat is also functional: executing the placeholder logs the
			# VOTC:DATE heartbeat the app's date tracking consumes. The real spam symptom
			# (console_failure: No such file in run/) is fixed app-side by the §42.3 startup
			# seed, which keeps this beat harmless.
			name = _show3
			trigger_on_create = yes
			duration = 2
			on_finish = "[ExecuteConsoleCommand('run votc_ce_letter_actions.txt')]"
		}

		state = {
			name = _show2
			trigger_when = "[Not(GetGlobalVariable('talk_scene').IsSet)]"
			duration = 2
			on_finish = "[ExecuteConsoleCommand('gui.createwidget gui/custom_gui/letters_runner.gui letters_runner_counter')]"
		}

		# VOTC-194: the NPC letter channel.  The desktop patch routes letterId
		# "npcltr" to run/votc_ce_npcltr.txt; this state executes it on the same beat as
		# the player's own letters.  Harmless when the file does not exist.
		state = {
			name = _show_npcltr
			trigger_on_create = yes
			on_finish = "[ExecuteConsoleCommand('run votc_ce_npcltr.txt')]"
		}

		# VOTC-194 §37.2.1: the 8 incoming-letter run files.  The arrival events
		# .0101-.0108 are hidden, so their event-window widgets never instantiate
		# and nothing else executes run/votc_ce_incomingletter_v2_N.txt.  These
		# states re-arm every ~2s via the _show2 counter recreation and fire while
		# their slot global exists; the run file's own guarded cleanup removes the
		# slot on success, which stops the state.  Re-execution is a harmless
		# no-op (guard + run_skipped else).  Polling pauses while a conversation is
		# open (_show2 gate) and resumes on the next recreation.
		state = {
			name = _show_incoming_1
			trigger_when = "[GetGlobalVariable('votc_incoming_letter_1').IsSet]"
			duration = 1
			on_finish = "[ExecuteConsoleCommand('run votc_ce_incomingletter_v2_1.txt')]"
		}

		state = {
			name = _show_incoming_2
			trigger_when = "[GetGlobalVariable('votc_incoming_letter_2').IsSet]"
			duration = 1
			on_finish = "[ExecuteConsoleCommand('run votc_ce_incomingletter_v2_2.txt')]"
		}

		state = {
			name = _show_incoming_3
			trigger_when = "[GetGlobalVariable('votc_incoming_letter_3').IsSet]"
			duration = 1
			on_finish = "[ExecuteConsoleCommand('run votc_ce_incomingletter_v2_3.txt')]"
		}

		state = {
			name = _show_incoming_4
			trigger_when = "[GetGlobalVariable('votc_incoming_letter_4').IsSet]"
			duration = 1
			on_finish = "[ExecuteConsoleCommand('run votc_ce_incomingletter_v2_4.txt')]"
		}

		state = {
			name = _show_incoming_5
			trigger_when = "[GetGlobalVariable('votc_incoming_letter_5').IsSet]"
			duration = 1
			on_finish = "[ExecuteConsoleCommand('run votc_ce_incomingletter_v2_5.txt')]"
		}

		state = {
			name = _show_incoming_6
			trigger_when = "[GetGlobalVariable('votc_incoming_letter_6').IsSet]"
			duration = 1
			on_finish = "[ExecuteConsoleCommand('run votc_ce_incomingletter_v2_6.txt')]"
		}

		state = {
			name = _show_incoming_7
			trigger_when = "[GetGlobalVariable('votc_incoming_letter_7').IsSet]"
			duration = 1
			on_finish = "[ExecuteConsoleCommand('run votc_ce_incomingletter_v2_7.txt')]"
		}

		state = {
			name = _show_incoming_8
			trigger_when = "[GetGlobalVariable('votc_incoming_letter_8').IsSet]"
			duration = 1
			on_finish = "[ExecuteConsoleCommand('run votc_ce_incomingletter_v2_8.txt')]"
		}

		# VOTC-194 §37.2.4 (mod half): display watcher.  The app's incoming run
		# file sets votc_incoming_letter_popup (and mirrors the slot's sender
		# into message_second_scope) right before its cleanup lines; this state
		# fires within ~2s (the counter recreates every ~2s via _show2) and
		# executes the display sgui, which consumes the marker and triggers the
		# stock non-hidden message_event.362 -> parchment.  Gated on the MARKER,
		# not the slot global: the run file removes the slot global atomically
		# with votc_latest_letter, so a slot+latest gate could never fire.
		# Inert until the app writes the marker; stock/npcltr letters never set
		# it, so no double-open.
		state = {
			name = _popup
			trigger_when = "[GetGlobalVariable('votc_incoming_letter_popup').IsSet]"
			duration = 1
			on_finish = "[GetScriptedGui('votc_incoming_letter_display_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}
	}
}
