#==========================================================================
#  VOTC-194: NPC Initiative - the NPC letter channel's runner
#
#  The letter system has its own run file: run/votc_ce_npcltr.txt.  The desktop app
#  writes a finished letter there (the desktop-side patch routes letterId
#  "npcltr" to this file instead of letters.txt), and this widget executes
#  it - the same idea as VOTC's own letters_runner.gui, but on a file of our
#  own so the player's own letters and this channel can never step on each
#  other.
#
#  This is the SECOND poller, kept as a backstop.  The primary one is VOTC's
#  own letters_runner, which the desktop patch extends to run votc_ce_npcltr.txt on
#  its beat; letters_runner runs for the whole session, while this widget
#  only exists after a letter has gone out.  Both running at once is
#  harmless: the script the app writes is wrapped in a per-reply guard, so
#  only the first pass does anything.
#
#  The loop condition is deliberately "nothing stopped us" rather than
#  "votc_ce_initiative_letter_pending is armed".  Gating the first runner on
#  a timed flag kills the poller with the flag - three seconds into a round
#  trip that takes the model a whole minute - so the reply would be written
#  to a file nobody is reading any more.  Copying letters_runner.gui's shape
#  (a counter widget re-created from its own state) keeps it alive instead.
#==========================================================================

window = {
	name = "votc_ce_npc_letter_runner"
	size = { 1% 1% }
	parentanchor = top|right
	movable = no
	layer = bottom_bottom

	state = {
		name = _boot
		trigger_on_create = yes
		on_finish = "[ExecuteConsoleCommand('run votc_ce_npcltr.txt')]"
	}

	hbox = {
		name = "votc_ce_npc_letter_runner_counter"

		state = {
			name = _show
			trigger_on_create = yes
			on_finish = "[ExecuteConsoleCommand('run votc_ce_npcltr.txt')]"
		}

		state = {
			name = _again
			trigger_when = "[Not(GetGlobalVariable('votc_ce_initiative_letter_halt').IsSet)]"
			duration = 2
			on_finish = "[ExecuteConsoleCommand('gui.createwidget gui/custom_gui/votc_ce_npc_letter_runner.gui votc_ce_npc_letter_runner_counter')]"
		}
	}
}