## VOTC NPC-initiated incoming letter widget (slot 3)
## Runs the desktop-generated letter script for slot 3.

hbox = {
	name = "event_window_widget_incoming_letter_3"
	layoutpolicy_horizontal = expanding
	margin = { 10 0 }

	state = {
		# Retry loop, not a one-shot: the desktop app writes run/votc_ce_incomingletter_v2_3.txt
		# only AFTER this widget is created (clipboard hop -> LLM generation -> atomic write),
		# so a create-time execution would miss the file.  trigger_when re-evaluates
		# continuously and the state re-fires every `duration` beats while the slot global
		# exists; the app's run file removes votc_incoming_letter_3 on success, which stops
		# the loop (the .0113 cleanup event clears the slot a day later if the app never
		# writes).  Re-running the file is a harmless no-op - its guard checks the slot
		# global + delivery id + type.
		name = widget_show
		trigger_when = "[GetGlobalVariable('votc_incoming_letter_3').IsSet]"
		duration = 2
		on_start = "[ExecuteConsoleCommand('run votc_ce_incomingletter_v2_3.txt')]"
		on_finish = "[ExecuteConsoleCommand('run votc_ce_incomingletter_v2_3.txt')]"
	}

	# VOTC-194 §26: once the app run file exposes the letter artifact via the
	# votc_latest_letter global, open the stock letter parchment (the same
	# window stock letters use) so the AI body renders.  GUI states
	# re-evaluate continuously, so this fires the moment the run file sets
	# the global - no event-desc timing dependency.  Inert until app plan
	# §13 ships (the gate never fires).  §29.2: this state is trigger_when-ONLY
	# (no trigger_on_create) so it re-evaluates continuously and fires the
	# moment the run file sets the global, even if that happens after the
	# widget is created - closing the race with the run-file execution.
	state = {
		name = widget_create_window
		trigger_when = "[GetGlobalVariable('votc_latest_letter').IsSet]"
		on_finish = "[ExecuteConsoleCommand('gui.createwidget gui/custom_gui/votc_letter.gui votc_letter')]"
	}

	expand = {}
}
