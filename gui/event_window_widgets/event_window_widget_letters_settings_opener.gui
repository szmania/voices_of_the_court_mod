## Opens the NPC incoming letters settings window from a bridge event.
## mod2 ce deliberately does not replace hud.gui, so the decision entry fires
## votc_letters_settings_bridge_event.9001, which shows this widget whose
## buttons issue the same console commands as the mod1 HUD button.
hbox = {
	name = "event_window_widget_letters_settings_opener"
	layoutpolicy_horizontal = expanding
	margin = { 10 0 }

	flowcontainer = {
		direction = vertical

		button_standard = {
			parentanchor = hcenter
            position = { 0 0 }
			size = { 260 34 }
			text = votc_incoming_letters_open_settings_button_text
			tooltip = votc_incoming_letters_settings_desc
			onclick = "[ExecuteConsoleCommands('GUI.ClearWidgets votc_incoming_letters_window; gui.createwidget gui/custom_gui/votc_incoming_letters_window.gui votc_incoming_letters_window')]"
		}

	}

	expand = {}
}
