## VOTC NPC-initiated incoming letter widget (slot 6)
## Runs the desktop-generated letter script for slot 6.

hbox = {
	name = "event_window_widget_incoming_letter_6"
	layoutpolicy_horizontal = expanding
	margin = { 10 0 }

	state = {
        name = widget_show
        trigger_on_create = yes

		on_start = "[ExecuteConsoleCommand('run votc_ce_incomingletter_v2_6.txt')]"
	}

	# VOTC-194 §26: once the app run file exposes the letter artifact via the
	# votc_latest_letter global, open the stock letter parchment (the same
	# window stock letters use) so the AI body renders.  GUI states
	# re-evaluate continuously, so this fires the moment the run file sets
	# the global - no event-desc timing dependency.  Inert until app plan
	# §13 ships (the gate simply never fires).
	state = {
		name = widget_create_window
		trigger_on_create = yes
		trigger_when = "[GetGlobalVariable('votc_latest_letter').IsSet]"
		on_finish = "[ExecuteConsoleCommand('gui.createwidget gui/custom_gui/votc_letter.gui votc_letter')]"
	}

	expand = {}
}
