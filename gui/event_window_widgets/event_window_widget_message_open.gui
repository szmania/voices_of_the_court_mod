hbox = {
	name = "event_window_widget_message_open"
	layoutpolicy_horizontal = expanding
	margin = { 10 0 }

	state = {
		name = widget_show
		trigger_on_create = yes
		on_finish = "[EventWindowData.CopyToClipboard]"
	}

	# VOTC-195 §56: the whisper fallback was removed (the dedicated channel
	# run/votc_ce_whisper.txt -> votc_whisper.30 is the only whisper path), so
	# every message_event.362 landing is an ordinary letter and must open the
	# parchment even while a whisper sequence is in flight.
	state = {
		name = widget_create_window
		trigger_on_create = yes
		on_finish = "[ExecuteConsoleCommand('gui.createwidget gui/custom_gui/votc_letter.gui votc_letter')]"
	}

	expand = {}
}
