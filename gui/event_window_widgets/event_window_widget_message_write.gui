vbox = {
	name = "event_window_widget_message_write"
	layoutpolicy_horizontal = expanding
	layoutpolicy_vertical = expanding

	# VOTC-194 §34.2.2: an invisible child must not reserve layout space, or the
	# hidden reply preview leaves a blank band above the textarea on the
	# fresh-letter path (preview visible = no).  Stock-proven on flow containers
	# (e.g. gui/shared/portraits.gui "[Character.IsValid]" + ignoreinvisible).
	ignoreinvisible = yes

	#margin = { 10 0 }
	#spacing = 10

	# VOTC-194 §30.3.1: reply-mode preview.  When the compose dialog was opened
	# by closing a replyable AI letter's parchment (votc_letter_replying), show
	# the letter being replied to in a scroll box ABOVE the text area.  Fresh
	# player-initiated letters never set the marker, so this stays hidden there.
	widget = {
		visible = "[GetGlobalVariable('votc_letter_replying').IsSet]"
		layoutpolicy_horizontal = expanding
		# Fixed vertical policy: the preview takes only the height of its
		# contents (header + 200px scrollbox); the editbox below keeps
		# expanding and fills the rest.  No overlap.
		layoutpolicy_vertical = fixed
		margin = { 30 0 }

		vbox = {
			layoutpolicy_horizontal = expanding

			text_single = {
				text = votc_letter_reply_scroll_header
				using = Font_Type_Flavor
				default_format = "#light_background"
			}

			scrollbox = {
				size = { 560 200 }
				layoutpolicy_horizontal = expanding
				# VOTC-194 §30.3.1 layout fix + §34.2.1: fixed vertical policy so
				# the preview keeps its explicit 200px height (size = { 560 200 };
				# the engine ignores min_size - use minimumsize if ever needed) and
				# stacks ABOVE the textarea instead of competing with it for
				# expanding space.
				layoutpolicy_vertical = fixed
				blockoverride "scrollbox_content"
				{
					text_multi = {
						max_width = 540
						autoresize = yes
						text = "[GetGlobalVariable('votc_latest_letter').Artifact.GetDesc]"
						default_format = "#light_background;italic"
						using = Font_Size_Medium
					}
				}
			}
		}
	}

	editbox_votc_with_label = {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		margin = { 30 30 }


		blockoverride "editbox_properties" 
		{
			name = "enter_text" # name referenced in code
			multiline = yes
			ontextedited = "[EventWindowWidgetEnterText.OnEdit]"
		}

		blockoverride "editbox_label"
		{
			text = event_window_widget_message_write_prompt
			
		}
	}


	expand = {}
}